{
  "name": "veyra",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@veyra/api --filter=@veyra/worker --filter=@veyra/console-web",
    "dev:api": "turbo run dev --filter=@veyra/api",
    "dev:worker": "turbo run dev --filter=@veyra/worker",
    "dev:console": "turbo run dev --filter=@veyra/console-web",
    "dev:marketing": "turbo run dev --filter=@veyra/marketing-web",
    "dev:admin": "turbo run dev --filter=@veyra/admin-web",
    "dev:mobile": "bun run --cwd apps/resident-mobile dev",
    "dev:staff": "bun run --cwd apps/staff-mobile dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate:dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Reverse proxies in front of the API (Cloudflare / load balancer = 1). 0 when clients connect directly.
API_TRUST_PROXY=0

# Worker
WORKER_HEALTH_PORT=4001

# Data stores (match docker-compose.yml and packages/db/sql/bootstrap-roles.sql; dev passwords only)
# API and worker: restricted role, row-level security always applies.
DATABASE_URL=postgresql://veyra_app:veyra_app_dev@localhost:5432/veyra
# Prisma migrate: schema owner. Never give this URL to the API or worker.
MIGRATION_DATABASE_URL=postgresql://veyra_owner:veyra_owner_dev@localhost:5432/veyra
REDIS_URL=redis://localhost:6379
# Sandbox payment gateway (development only; no money moves). At least 32 characters.
PAYMENT_SANDBOX_SECRET=local-sandbox-secret-change-me-0123456789
# Webhook master key (API and worker; base64, at least 32 bytes). Development value only:
# generate a new one per environment, e.g. `openssl rand -base64 32`.
WEBHOOK_SIGNING_KEY=ZGV2LW9ubHktd2ViaG9vay1rZXktY2hhbmdlLW1lLTAxMjM0NTY3ODk=
# Object storage for uploaded files (SeaweedFS from docker-compose.yml; dev credentials only).
# Omit STORAGE_ENDPOINT for AWS S3; for Cloudflare R2 use the account endpoint and region "auto".
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=veyra-dev
STORAGE_ACCESS_KEY_ID=veyra
STORAGE_SECRET_ACCESS_KEY=veyra-storage-dev
STORAGE_FORCE_PATH_STYLE=true

# Web apps (console-web :3000, marketing-web :3001, admin-web :3002)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CONTACT_EMAIL=

# Mobile (resident-mobile). Use your PC's LAN IP: a phone cannot reach "localhost" on your PC.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1

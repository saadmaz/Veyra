# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Worker
WORKER_HEALTH_PORT=4001

# Data stores (match docker-compose.yml)
DATABASE_URL=postgresql://veyra:veyra@localhost:5432/veyra?schema=public
REDIS_URL=redis://localhost:6379

# Web apps (console-web :3000, marketing-web :3001, admin-web :3002)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CONTACT_EMAIL=

# Mobile (resident-mobile). Use your PC's LAN IP: a phone cannot reach "localhost" on your PC.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1

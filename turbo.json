{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

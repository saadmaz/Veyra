// VEYRA database schema: the executable source of truth for the data model.
// Intent and invariants: docs/architecture/DATA_MODEL.md and docs/architecture/MULTI_TENANCY.md.
// The connection URL lives in prisma.config.ts (Prisma 7), not here.
//
// Row-level security policies, database grants, check constraints and the audit-log immutability
// trigger are NOT expressible in Prisma. They live as raw SQL in the migrations and are covered by
// integration tests (test/integration). Never edit an applied migration; add a new one.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Identity (global: a person has one account across all organisations)
// ---------------------------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case and trimmed (enforced by a CHECK constraint).
  email           String     @unique
  displayName     String     @map("display_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential PasswordCredential?
  sessions           Session[]
  memberships        Membership[]
  persons            Person[]

  visitorInvitationsCreated VisitorInvitation[] @relation("InvitationCreatedBy")
  visitorInvitationsRevoked VisitorInvitation[] @relation("InvitationRevokedBy")
  visitsRecorded            Visit[]             @relation("VisitRecordedBy")
  visitDeparturesRecorded   Visit[]             @relation("VisitDepartureRecordedBy")
  accessEvents              AccessEvent[]
  walkInRequestsMade        WalkInRequest[]     @relation("WalkInRequestedBy")
  walkInRequestsDecided     WalkInRequest[]     @relation("WalkInDecidedBy")
  visitsReviewed            Visit[]             @relation("VisitReviewedBy")

  accountingPeriodsClosed AccountingPeriod[]  @relation("PeriodClosedBy")
  recurringChargesCreated RecurringCharge[]   @relation("RecurringChargeCreatedBy")
  invoicesCreated         Invoice[]           @relation("InvoiceCreatedBy")
  invoicesIssued          Invoice[]           @relation("InvoiceIssuedBy")
  paymentsRecorded        Payment[]           @relation("PaymentRecordedBy")
  allocationsMade         PaymentAllocation[] @relation("AllocationMadeBy")
  allocationsReleased     PaymentAllocation[] @relation("AllocationReleasedBy")
  paymentIntentsCreated   PaymentIntent[]     @relation("PaymentIntentCreatedBy")
  journalEntriesCreated   JournalEntry[]      @relation("JournalEntryCreatedBy")
  journalEntriesPosted    JournalEntry[]      @relation("JournalEntryPostedBy")

  approvalsRequested      FinanceApproval[]        @relation("ApprovalRequestedBy")
  approvalsDecided        FinanceApproval[]        @relation("ApprovalDecidedBy")
  invoiceCreditsCreated   InvoiceCredit[]          @relation("InvoiceCreditCreatedBy")
  paymentRefundsCreated   PaymentRefund[]          @relation("PaymentRefundCreatedBy")
  paymentReversalsCreated PaymentReversal[]        @relation("PaymentReversalCreatedBy")
  bankTransfersSubmitted  BankTransferSubmission[] @relation("BankTransferSubmittedBy")
  bankTransfersDecided    BankTransferSubmission[] @relation("BankTransferDecidedBy")
  maintenanceRequests     MaintenanceRequest[]     @relation("MaintenanceRequestSubmittedBy")
  maintenanceAccepted     MaintenanceRequest[]     @relation("MaintenanceRequestAcceptedBy")
  workOrdersAssigned      WorkOrder[]              @relation("WorkOrderAssignee")
  workOrdersCreated       WorkOrder[]              @relation("WorkOrderCreatedBy")
  workOrderCostsRecorded  WorkOrderCost[]          @relation("WorkOrderCostRecordedBy")
  workOrderCostsVoided    WorkOrderCost[]          @relation("WorkOrderCostVoidedBy")
  maintenanceEvents       MaintenanceEvent[]       @relation("MaintenanceEventActor")
  attachmentsUploaded     MaintenanceAttachment[]  @relation("MaintenanceAttachmentUploadedBy")
  attachmentsRemoved      MaintenanceAttachment[]  @relation("MaintenanceAttachmentRemovedBy")
  facilityClosures        FacilityClosure[]        @relation("FacilityClosureCreatedBy")
  facilityClosuresLifted  FacilityClosure[]        @relation("FacilityClosureLiftedBy")
  facilityBookingsMade    FacilityBooking[]        @relation("FacilityBookingBookedBy")
  facilityBookingsDecided FacilityBooking[]        @relation("FacilityBookingDecidedBy")
  facilityBookingEvents   FacilityBookingEvent[]   @relation("FacilityBookingEventActor")

  @@map("users")
}

/// Built-in password authentication (ADR 0005). Removed or bypassed when an external identity
/// provider is adopted.
model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  /// argon2id PHC string. Never logged, never returned by the API.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

/// How a session token travels. A token is accepted only on its own transport, so a mobile
/// (bearer) token cannot be replayed as a web cookie and vice versa.
enum SessionClient {
  /// httpOnly cookie, shorter lifetime
  WEB
  /// Authorization: Bearer header, kept in the device's secure store
  MOBILE
}

/// Server-side session. The client holds an opaque random token; only its SHA-256 hash is stored.
model Session {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  tokenHash         String        @unique @map("token_hash")
  client            SessionClient
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime      @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime      @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ipAddress         String?       @map("ip_address")
  userAgent         String?       @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------------------------
// Tenancy (tenant-owned tables carry organisation_id and are protected by row-level security)
// ---------------------------------------------------------------------------------------------

enum OrganisationStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED
}

model Organisation {
  id              String             @id @default(uuid(7)) @db.Uuid
  name            String
  /// URL-safe unique identifier, lower-case.
  slug            String             @unique
  /// ISO 3166-1 alpha-2.
  countryCode     String             @map("country_code") @db.Char(2)
  /// ISO 4217.
  defaultCurrency String             @map("default_currency") @db.Char(3)
  /// IANA time zone, e.g. "Asia/Karachi".
  defaultTimeZone String             @map("default_time_zone")
  status          OrganisationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  properties  Property[]
  persons     Person[]

  @@map("organisations")
}

enum ScopeType {
  ORGANISATION
  PROPERTY
  BUILDING
  UNIT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Grants a role (defined in code, docs/security/ACCESS_CONTROL.md) to a user at a scope for a
/// validity period. PROPERTY/BUILDING/UNIT scope ids are checked by a trigger (same organisation).
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           String
  scopeType      ScopeType        @default(ORGANISATION) @map("scope_type")
  scopeId        String           @map("scope_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  validFrom      DateTime         @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime?        @map("valid_until") @db.Timestamptz(3)
  grantedById    String?          @map("granted_by_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedById    String?          @map("revoked_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organisationId, userId, role, scopeType, scopeId])
  @@index([userId])
  @@index([organisationId, scopeType, scopeId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  email          String
  role           String
  scopeType      ScopeType @default(ORGANISATION) @map("scope_type")
  scopeId        String    @map("scope_id") @db.Uuid
  /// SHA-256 of the single-use invitation token.
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedById    String    @map("invited_by_id") @db.Uuid
  /// Set for a resident invitation: accepting links this person profile to the accepting login
  /// instead of creating a membership (role RESIDENT, organisation scope).
  personId       String?   @map("person_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  person       Person?      @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------------------------
// Platform records
// ---------------------------------------------------------------------------------------------

/// Append-only (UPDATE/DELETE rejected by trigger). organisation_id is null for platform events
/// such as sign-in. No foreign keys: audit records outlive the rows they describe.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json     @default("{}")
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same transaction as the state change, relayed to BullMQ
/// by the worker. Internal only (never exposed through the API), so not tenant-filtered by RLS.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String?   @map("organisation_id") @db.Uuid
  type           String
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------------------------
// Property structure (Phase 3). Every table is tenant-owned (organisation_id + RLS). Children
// reference parents through composite keys that include organisation_id (and property_id), so
// a row can never point at another tenant's or another property's parent. Rows are archived,
// never deleted: the application role has no DELETE privilege on these tables.
// ---------------------------------------------------------------------------------------------

enum PropertyType {
  CONDOMINIUM
  APARTMENT_COMPLEX
  GATED_COMMUNITY
  MIXED_USE
  OTHER
}

enum PropertyStatus {
  /// Being set up: structure and settings can change freely.
  ONBOARDING
  ACTIVE
  /// Read-only history. Archiving does not delete anything.
  ARCHIVED
}

/// Lifecycle of buildings, floors, units and common areas.
enum StructureStatus {
  ACTIVE
  ARCHIVED
}

enum UnitType {
  APARTMENT
  PENTHOUSE
  STUDIO
  DUPLEX
  VILLA
  TOWNHOUSE
  SHOP
  OFFICE
  STORAGE
  OTHER
}

enum CommonAreaType {
  LOBBY
  POOL
  GYM
  CLUBHOUSE
  FUNCTION_ROOM
  SPORTS_FACILITY
  PLAYGROUND
  GARDEN
  PARKING
  OTHER
}

model Property {
  id             String         @id @default(uuid(7)) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  name           String
  /// Short code unique within the organisation, e.g. "HVR". Upper-case letters, digits, hyphens.
  code           String
  type           PropertyType
  status         PropertyStatus @default(ONBOARDING)
  addressLine1   String         @map("address_line1")
  addressLine2   String?        @map("address_line2")
  city           String
  region         String?
  postalCode     String?        @map("postal_code")
  /// ISO 3166-1 alpha-2.
  countryCode    String         @map("country_code") @db.Char(2)
  /// IANA time zone used for the property's local dates (due dates, bookings).
  timeZone       String         @map("time_zone")
  /// ISO 4217. Fixed once financial records exist (enforced by the finance module).
  currency       String         @db.Char(3)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  buildings    Building[]
  floors       Floor[]
  units        Unit[]
  commonAreas  CommonArea[]
  vehicles     Vehicle[]

  visitorInvitations VisitorInvitation[]
  visitorPasses      VisitorPass[]
  visits             Visit[]
  accessEvents       AccessEvent[]
  walkInRequests     WalkInRequest[]

  ledgerAccounts    LedgerAccount[]
  chargeTypes       ChargeType[]
  recurringCharges  RecurringCharge[]
  invoices          Invoice[]
  payments          Payment[]
  paymentIntents    PaymentIntent[]
  paymentEvents     PaymentProviderEvent[]
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]

  financeApprovals FinanceApproval[]
  bankTransfers    BankTransferSubmission[]

  maintenanceSlaTargets  MaintenanceSlaTarget[]
  maintenanceRequests    MaintenanceRequest[]
  workOrders             WorkOrder[]
  workOrderCosts         WorkOrderCost[]
  maintenanceEvents      MaintenanceEvent[]
  maintenanceAttachments MaintenanceAttachment[]

  facilities            Facility[]
  facilityOpeningHours  FacilityOpeningHours[]
  facilityClosures      FacilityClosure[]
  facilityBookings      FacilityBooking[]
  facilityBookingEvents FacilityBookingEvent[]

  @@unique([organisationId, id])
  @@unique([organisationId, code])
  @@map("properties")
}

model Building {
  id             String          @id @default(uuid(7)) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  name           String
  /// Short code unique within the property, e.g. "A" or "TOWER-1".
  code           String
  status         StructureStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property     @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  floors      Floor[]
  units       Unit[]
  commonAreas CommonArea[]

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, code])
  @@index([organisationId, propertyId])
  @@map("buildings")
}

model Floor {
  id             String          @id @default(uuid(7)) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  buildingId     String          @map("building_id") @db.Uuid
  /// Storey number: 0 ground, negative basements.
  level          Int
  /// Display name, e.g. "Ground", "Mezzanine", "B2".
  name           String
  status         StructureStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  building Building @relation(fields: [organisationId, propertyId, buildingId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  units    Unit[]

  @@unique([organisationId, propertyId, buildingId, id])
  @@unique([buildingId, level])
  @@map("floors")
}

/// A unit may sit in a building (apartment) or directly in the property (villa). A floor
/// requires a building. Unit numbers are unique per building, or per property without one.
model Unit {
  id             String          @id @default(uuid(7)) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  buildingId     String?         @map("building_id") @db.Uuid
  floorId        String?         @map("floor_id") @db.Uuid
  /// Label shown to people, e.g. "12B" or "Villa 7".
  number         String
  type           UnitType
  /// Internal floor area in square metres.
  areaSqm        Decimal?        @map("area_sqm") @db.Decimal(10, 2)
  /// Entitlement used to apportion shared charges (finance, Phase 6). Positive.
  shareRatio     Decimal?        @map("share_ratio") @db.Decimal(12, 6)
  status         StructureStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property  @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  building Building? @relation(fields: [organisationId, propertyId, buildingId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  floor    Floor?    @relation(fields: [organisationId, propertyId, buildingId, floorId], references: [organisationId, propertyId, buildingId, id], onDelete: Restrict, onUpdate: Restrict)

  ownerships       Ownership[]
  tenancies        Tenancy[]
  householdMembers HouseholdMember[]
  vehicles         Vehicle[]

  visitorInvitations VisitorInvitation[]
  visits             Visit[]
  walkInRequests     WalkInRequest[]

  journalLines     JournalLine[]
  recurringCharges RecurringCharge[]
  invoices         Invoice[]
  payments         Payment[]
  paymentIntents   PaymentIntent[]
  bankTransfers    BankTransferSubmission[]

  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  facilityBookings    FacilityBooking[]

  @@unique([organisationId, propertyId, id])
  @@index([organisationId, propertyId])
  @@index([buildingId])
  @@map("units")
}

model CommonArea {
  id             String          @id @default(uuid(7)) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  /// Optional: a gym inside tower A, or null for a property-wide pool.
  buildingId     String?         @map("building_id") @db.Uuid
  name           String
  type           CommonAreaType
  status         StructureStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property  @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  building Building? @relation(fields: [organisationId, propertyId, buildingId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)

  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  facility            Facility?

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, name])
  @@index([organisationId, propertyId])
  @@map("common_areas")
}

// ---------------------------------------------------------------------------------------------
// Residents (Phase 4). A Person is a resident profile, separate from a login (User). Relations
// to units are effective-dated with calendar dates (property-local, inclusive end) and are never
// deleted: mistakes are voided (voided_at). Owner and tenant access is derived from these rows.
// Personal data is kept to the minimum agreed for Phase 4: name, email, phone, language.
// ---------------------------------------------------------------------------------------------

enum PersonStatus {
  ACTIVE
  /// No longer current. Kept for history; personal data erasure is a separate, later process.
  ARCHIVED
}

model Person {
  id                String       @id @default(uuid(7)) @db.Uuid
  organisationId    String       @map("organisation_id") @db.Uuid
  /// Set once the person has a login and has accepted a verified invitation (Part 2).
  userId            String?      @map("user_id") @db.Uuid
  fullName          String       @map("full_name")
  /// Lower-case and trimmed (CHECK). Unique in the organisation when present.
  email             String?
  /// E.164, e.g. +923001234567 (CHECK).
  phone             String?
  /// BCP 47 language tag, e.g. "en", "ur-PK".
  preferredLanguage String?      @map("preferred_language")
  status            PersonStatus @default(ACTIVE)
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation      Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user              User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerships        Ownership[]
  tenancyOccupants  TenancyOccupant[]
  householdMembers  HouseholdMember[]
  emergencyContacts EmergencyContact[]
  vehicles          Vehicle[]
  invitations       Invitation[]
  hostedVisitors    VisitorInvitation[]
  invoicesBilled    InvoiceRecipient[]

  @@unique([organisationId, id])
  @@unique([organisationId, userId])
  @@index([organisationId, fullName])
  @@map("persons")
}

/// A person owns a share of a unit for a period. Shares are exact fractions; for every date on
/// which a unit has owners, the shares sum to exactly 1 (deferred constraint trigger).
model Ownership {
  id               String    @id @default(uuid(7)) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  personId         String    @map("person_id") @db.Uuid
  shareNumerator   Int       @map("share_numerator")
  shareDenominator Int       @map("share_denominator")
  /// First day of ownership (inclusive), in the property's local calendar.
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  /// Last day of ownership (inclusive); null while current.
  effectiveTo      DateTime? @map("effective_to") @db.Date
  /// Set when the record was entered by mistake; voided rows are ignored by every rule.
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason       String?   @map("void_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit   Unit   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  person Person @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, unitId])
  @@index([organisationId, personId])
  @@map("ownerships")
}

/// A lease of one unit. One tenancy per unit at a time; several tenants may share it.
model Tenancy {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  /// First day (inclusive), property-local.
  startDate      DateTime  @map("start_date") @db.Date
  /// Last day (inclusive); null for an open-ended tenancy.
  endDate        DateTime? @map("end_date") @db.Date
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit           Unit                     @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  occupants      TenancyOccupant[]
  invoices       Invoice[]
  payments       Payment[]
  paymentIntents PaymentIntent[]
  bankTransfers  BankTransferSubmission[]

  @@unique([organisationId, id])
  @@index([organisationId, unitId])
  @@map("tenancies")
}

/// A tenant on a lease. Exactly one primary tenant per tenancy (partial unique index).
model TenancyOccupant {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  tenancyId      String   @map("tenancy_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenancy Tenancy @relation(fields: [organisationId, tenancyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  person  Person  @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenancyId, personId])
  @@index([organisationId, personId])
  @@map("tenancy_occupants")
}

enum HouseholdRelationship {
  SPOUSE_OR_PARTNER
  CHILD
  PARENT
  OTHER_RELATIVE
  DOMESTIC_STAFF
  OTHER
}

/// Someone who lives in a unit without owning or renting it. Delegated permissions: Part 2.
model HouseholdMember {
  id             String                @id @default(uuid(7)) @db.Uuid
  organisationId String                @map("organisation_id") @db.Uuid
  propertyId     String                @map("property_id") @db.Uuid
  unitId         String                @map("unit_id") @db.Uuid
  personId       String                @map("person_id") @db.Uuid
  relationship   HouseholdRelationship
  validFrom      DateTime              @map("valid_from") @db.Date
  validTo        DateTime?             @map("valid_to") @db.Date
  voidedAt       DateTime?             @map("voided_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit   Unit   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  person Person @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, unitId])
  @@index([organisationId, personId])
  @@map("household_members")
}

/// Not historical: contacts can be replaced and deleted.
model EmergencyContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  name           String
  /// E.164.
  phone          String
  relationship   String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person Person @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, personId])
  @@map("emergency_contacts")
}

enum VehicleStatus {
  ACTIVE
  ARCHIVED
}

/// A resident's vehicle at a property. Plates are normalised (upper case, no spaces) and unique
/// per property among active vehicles.
model Vehicle {
  id             String        @id @default(uuid(7)) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  unitId         String?       @map("unit_id") @db.Uuid
  personId       String?       @map("person_id") @db.Uuid
  plate          String
  make           String?
  model          String?
  colour         String?
  status         VehicleStatus @default(ACTIVE)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit     Unit?    @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  person   Person?  @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, propertyId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------------------------
// Visitors and access (Phase 5). Integrity rules, the admission backstop, append-only access
// events and row-level security are hand-written in migration 20261111120000_visitors.
// Visitor personal data is limited to name, optional phone and optional vehicle plate.
// ---------------------------------------------------------------------------------------------

enum VisitorCategory {
  GUEST
  DELIVERY
  CONTRACTOR
  SERVICE_PROVIDER
}

/// Expiry is not a status: an ACTIVE invitation outside its window is simply not valid.
enum VisitorInvitationStatus {
  ACTIVE
  REVOKED
}

enum VisitDecision {
  ADMITTED
  DENIED
}

/// How the record reached VEYRA: live at the gate, typed in from the paper log, or synced from
/// the offline gate app. Only ONLINE admissions are checked against the invitation at insert.
enum VisitSource {
  ONLINE
  PAPER
  OFFLINE_SYNC
}

enum AccessEventType {
  PASS_ACCEPTED
  PASS_REJECTED
  VISIT_ADMITTED
  VISIT_DENIED
  VISIT_DEPARTED
}

/// A resident's or staff member's pre-registration of a visitor for one unit and time window.
model VisitorInvitation {
  id              String                  @id @default(uuid(7)) @db.Uuid
  organisationId  String                  @map("organisation_id") @db.Uuid
  propertyId      String                  @map("property_id") @db.Uuid
  unitId          String                  @map("unit_id") @db.Uuid
  /// The resident being visited; null when staff register a visitor without naming one.
  hostPersonId    String?                 @map("host_person_id") @db.Uuid
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  category        VisitorCategory
  visitorName     String                  @map("visitor_name")
  /// E.164 (CHECK).
  visitorPhone    String?                 @map("visitor_phone")
  /// Upper case, A-Z 0-9 and hyphens (CHECK), like vehicles.plate.
  vehiclePlate    String?                 @map("vehicle_plate")
  validFrom       DateTime                @map("valid_from") @db.Timestamptz(3)
  validUntil      DateTime                @map("valid_until") @db.Timestamptz(3)
  /// How many admissions the invitation allows (1 for a single visit).
  maxEntries      Int                     @default(1) @map("max_entries")
  status          VisitorInvitationStatus @default(ACTIVE)
  revokedAt       DateTime?               @map("revoked_at") @db.Timestamptz(3)
  /// Null when revoked by the system (e.g. the host moved out).
  revokedByUserId String?                 @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  property  Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit     @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  host      Person?  @relation(fields: [organisationId, hostPersonId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy User?    @relation("InvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  passes       VisitorPass[]
  visits       Visit[]
  accessEvents AccessEvent[]

  @@unique([organisationId, id])
  @@unique([organisationId, propertyId, id])
  @@unique([organisationId, propertyId, unitId, id])
  @@index([organisationId, unitId, validUntil])
  @@index([organisationId, propertyId, validFrom])
  @@map("visitor_invitations")
}

/// The credential shown at the gate: a QR token and a short reference code. Only SHA-256 hashes
/// are stored. A pass is never proof of identity; the guard still checks the visitor.
model VisitorPass {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  invitationId   String    @map("invitation_id") @db.Uuid
  /// SHA-256 (hex) of the random QR token.
  tokenHash      String    @unique @map("token_hash")
  /// SHA-256 (hex) of the reference code typed by a guard.
  codeHash       String    @map("code_hash")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  property   Property          @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  invitation VisitorInvitation @relation(fields: [organisationId, propertyId, invitationId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  visits     Visit[]

  @@unique([organisationId, invitationId, id])
  @@index([organisationId, invitationId])
  @@map("visitor_passes")
}

/// One decision at the gate: a visitor admitted (and later departed) or denied entry.
/// Pre-registered visits link their invitation and pass; walk-ins have neither.
model Visit {
  id                        String          @id @default(uuid(7)) @db.Uuid
  organisationId            String          @map("organisation_id") @db.Uuid
  propertyId                String          @map("property_id") @db.Uuid
  /// The unit visited; null for visits to the property itself (e.g. the management office).
  unitId                    String?         @map("unit_id") @db.Uuid
  invitationId              String?         @map("invitation_id") @db.Uuid
  passId                    String?         @map("pass_id") @db.Uuid
  category                  VisitorCategory
  visitorName               String          @map("visitor_name")
  visitorPhone              String?         @map("visitor_phone")
  vehiclePlate              String?         @map("vehicle_plate")
  decision                  VisitDecision
  denialReason              String?         @map("denial_reason")
  gate                      String?
  /// When the decision happened (for paper and offline records, earlier than created_at).
  arrivedAt                 DateTime        @map("arrived_at") @db.Timestamptz(3)
  departedAt                DateTime?       @map("departed_at") @db.Timestamptz(3)
  recordedByUserId          String          @map("recorded_by_user_id") @db.Uuid
  departureRecordedByUserId String?         @map("departure_recorded_by_user_id") @db.Uuid
  source                    VisitSource     @default(ONLINE)
  /// The resident's approval this walk-in was admitted on (Phase 5 Part 3). Used at most once.
  walkInRequestId           String?         @unique @map("walk_in_request_id") @db.Uuid
  /// Set by the device for offline and paper entries, so a retried sync never records twice.
  clientRef                 String?         @map("client_ref") @db.Uuid
  /// Why a paper or offline entry needs a supervisor's review (e.g. REVOKED); null when it does not.
  reviewReason              String?         @map("review_reason")
  reviewedAt                DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId          String?         @map("reviewed_by_user_id") @db.Uuid
  reviewNote                String?         @map("review_note")
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  property            Property           @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit                Unit?              @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  invitation          VisitorInvitation? @relation(fields: [organisationId, propertyId, unitId, invitationId], references: [organisationId, propertyId, unitId, id], onDelete: Restrict, onUpdate: Restrict)
  pass                VisitorPass?       @relation(fields: [organisationId, invitationId, passId], references: [organisationId, invitationId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy          User               @relation("VisitRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departureRecordedBy User?              @relation("VisitDepartureRecordedBy", fields: [departureRecordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  walkInRequest       WalkInRequest?     @relation(fields: [organisationId, propertyId, unitId, walkInRequestId], references: [organisationId, propertyId, unitId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy          User?              @relation("VisitReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessEvents        AccessEvent[]

  @@unique([organisationId, id])
  @@unique([organisationId, clientRef])
  @@index([organisationId, propertyId, arrivedAt])
  @@index([organisationId, invitationId])
  @@map("visits")
}

/// Append-only gate log (no personal data): what was scanned or decided, where and by whom.
model AccessEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  propertyId     String          @map("property_id") @db.Uuid
  type           AccessEventType
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(3)
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  invitationId   String?         @map("invitation_id") @db.Uuid
  visitId        String?         @map("visit_id") @db.Uuid
  gate           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  property   Property           @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor      User?              @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation VisitorInvitation? @relation(fields: [organisationId, invitationId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  visit      Visit?             @relation(fields: [organisationId, visitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, propertyId, occurredAt])
  @@map("access_events")
}

/// Expiry is not a status: a PENDING request past expires_at is expired.
enum WalkInRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

/// A guard asks the residents of a unit to let in someone without a pass (Phase 5 Part 3).
/// Decided once, before it expires; an approval admits one visit within a short time.
model WalkInRequest {
  id                String              @id @default(uuid(7)) @db.Uuid
  organisationId    String              @map("organisation_id") @db.Uuid
  propertyId        String              @map("property_id") @db.Uuid
  unitId            String              @map("unit_id") @db.Uuid
  category          VisitorCategory
  visitorName       String              @map("visitor_name")
  visitorPhone      String?             @map("visitor_phone")
  vehiclePlate      String?             @map("vehicle_plate")
  gate              String?
  requestedByUserId String              @map("requested_by_user_id") @db.Uuid
  status            WalkInRequestStatus @default(PENDING)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(3)
  /// The resident who approved or denied, or the guard who cancelled.
  decidedByUserId   String?             @map("decided_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit     @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User     @relation("WalkInRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy   User?    @relation("WalkInDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// At most one (visits.walk_in_request_id is unique).
  visits      Visit[]

  @@unique([organisationId, propertyId, unitId, id])
  @@index([organisationId, unitId, expiresAt])
  @@index([organisationId, propertyId, createdAt])
  @@map("walk_in_requests")
}

// ---------------------------------------------------------------------------------------------
// Finance ledger (Phase 6). Double-entry, per property, in the property's currency. Posting
// rules, immutability of posted entries, reversals and the period lock are hand-written in
// migration 20261112090000_ledger. Amounts are integers in the currency's minor unit (bigint),
// never floating point.
// ---------------------------------------------------------------------------------------------

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum LedgerAccountStatus {
  ACTIVE
  /// Kept for history; refuses new postings.
  ARCHIVED
}

enum AccountingPeriodStatus {
  OPEN
  /// No posting may be dated inside a closed period.
  CLOSED
}

enum JournalEntryStatus {
  /// Being prepared: lines may be added, changed or removed, and the draft may be deleted.
  DRAFT
  /// Immutable. Corrected only by a reversing entry.
  POSTED
}

/// What produced the entry. Business documents (invoices, payments, credit notes, refunds,
/// write-offs) add their own values as they are built.
enum JournalSource {
  MANUAL
  OPENING_BALANCE
  REVERSAL
  INVOICE
  PAYMENT
  ALLOCATION
  CREDIT_NOTE
  WRITE_OFF
  REFUND
}

/// An account in a property's chart of accounts. Accounts are archived, never deleted.
model LedgerAccount {
  id             String              @id @default(uuid(7)) @db.Uuid
  organisationId String              @map("organisation_id") @db.Uuid
  propertyId     String              @map("property_id") @db.Uuid
  /// Unique within the property, e.g. "1100". Upper-case letters, digits, dots and hyphens.
  code           String
  name           String
  type           LedgerAccountType
  /// Set on accounts the system posts to (e.g. RECEIVABLES, UNIT_CREDIT); unique per property.
  systemKey      String?             @map("system_key")
  status         LedgerAccountStatus @default(ACTIVE)
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property      @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  lines       JournalLine[]
  chargeTypes ChargeType[]

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, code])
  @@unique([propertyId, systemKey])
  @@map("ledger_accounts")
}

/// A span of the property's local calendar (inclusive dates). Postings must fall inside an OPEN
/// period; periods of one property never overlap.
model AccountingPeriod {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organisationId String                 @map("organisation_id") @db.Uuid
  propertyId     String                 @map("property_id") @db.Uuid
  startDate      DateTime               @map("start_date") @db.Date
  endDate        DateTime               @map("end_date") @db.Date
  status         AccountingPeriodStatus @default(OPEN)
  closedAt       DateTime?              @map("closed_at") @db.Timestamptz(3)
  closedByUserId String?                @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  closedBy User?    @relation("PeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  approvals FinanceApproval[]

  @@unique([organisationId, propertyId, id])
  @@index([organisationId, propertyId, startDate])
  @@map("accounting_periods")
}

/// A ledger transaction. Posting checks balance, accounts, the period and the currency, and
/// assigns the next entry number of the property; after that nothing about it changes.
model JournalEntry {
  id              String             @id @default(uuid(7)) @db.Uuid
  organisationId  String             @map("organisation_id") @db.Uuid
  propertyId      String             @map("property_id") @db.Uuid
  /// Sequential per property, assigned when posted (no gaps among posted entries).
  entryNumber     BigInt?            @map("entry_number")
  /// The accounting date, in the property's local calendar.
  entryDate       DateTime           @map("entry_date") @db.Date
  description     String
  source          JournalSource
  /// ISO 4217; always the property's currency.
  currency        String             @db.Char(3)
  status          JournalEntryStatus @default(DRAFT)
  /// The posted entry this one reverses (source REVERSAL). An entry is reversed at most once.
  reversesEntryId String?            @map("reverses_entry_id") @db.Uuid
  /// Null when the system created it (e.g. a payment provider callback).
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  postedAt        DateTime?          @map("posted_at") @db.Timestamptz(3)
  postedByUserId  String?            @map("posted_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  property           Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  reverses           JournalEntry?       @relation("Reversal", fields: [organisationId, propertyId, reversesEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy         JournalEntry?       @relation("Reversal")
  createdBy          User?               @relation("JournalEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  postedBy           User?               @relation("JournalEntryPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines              JournalLine[]
  invoice            Invoice?
  payment            Payment?
  allocations        PaymentAllocation[] @relation("AllocationEntry")
  allocationReleases PaymentAllocation[] @relation("AllocationReleaseEntry")

  invoiceCredit   InvoiceCredit?
  paymentRefund   PaymentRefund?
  paymentReversal PaymentReversal?

  @@unique([organisationId, propertyId, id])
  @@unique([organisationId, propertyId, id, currency])
  @@unique([organisationId, propertyId, reversesEntryId])
  @@unique([propertyId, entryNumber])
  @@index([organisationId, propertyId, entryDate])
  @@map("journal_entries")
}

/// One side of a ledger transaction: exactly one of debit or credit is positive.
model JournalLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  /// Order within the entry, from 1.
  lineNumber     Int      @map("line_number")
  accountId      String   @map("account_id") @db.Uuid
  /// The unit the amount concerns (receivables, unit credit); null for property-level lines.
  unitId         String?  @map("unit_id") @db.Uuid
  /// Minor units of the currency (e.g. paisa). Never negative.
  debitMinor     BigInt   @default(0) @map("debit_minor")
  creditMinor    BigInt   @default(0) @map("credit_minor")
  /// ISO 4217; always the entry's currency (composite key).
  currency       String   @db.Char(3)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry   JournalEntry  @relation(fields: [organisationId, propertyId, entryId, currency], references: [organisationId, propertyId, id, currency], onDelete: Restrict, onUpdate: Restrict)
  account LedgerAccount @relation(fields: [organisationId, propertyId, accountId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  unit    Unit?         @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([entryId, lineNumber])
  @@index([organisationId, accountId])
  @@index([organisationId, unitId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------------------------
// Billing (Phase 6 Part 2). Charge types, recurring charges and invoices. Issuing an invoice
// posts a journal entry in the same transaction. Integrity rules (issue checks, immutability of
// issued invoices, no double billing of a recurring charge) are hand-written in migration
// 20261112120000_billing.
// ---------------------------------------------------------------------------------------------

/// Who a charge type is billed to (owner decision, 2026-11-11).
enum ChargeLiableParty {
  /// The unit's owners (e.g. service charges).
  OWNERS
  /// The current tenants, or the owners while the unit has no tenancy (e.g. utilities).
  OCCUPANT
}

enum ChargeTypeStatus {
  ACTIVE
  ARCHIVED
}

enum RecurringChargeBasis {
  /// The same amount every month.
  FLAT
  /// A rate per square metre of the unit's area, rounded half up to the minor unit.
  PER_SQM
}

enum InvoiceStatus {
  /// Being prepared: lines may change and the draft may be discarded. Nothing is in the ledger.
  DRAFT
  /// Numbered and posted to the ledger. Never changes.
  ISSUED
}

/// Who an invoice is addressed to, resolved on its billing date.
enum InvoiceBillTo {
  OWNERS
  TENANTS
}

/// A kind of charge a property bills, with the income account it books to.
model ChargeType {
  id              String            @id @default(uuid(7)) @db.Uuid
  organisationId  String            @map("organisation_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  /// Unique within the property, e.g. "SERVICE". Upper-case letters, digits and hyphens.
  code            String
  name            String
  liableParty     ChargeLiableParty @map("liable_party")
  /// An INCOME account of the same property, or a LIABILITY for money held (facility deposits).
  incomeAccountId String            @map("income_account_id") @db.Uuid
  status          ChargeTypeStatus  @default(ACTIVE)
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  property         Property          @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  incomeAccount    LedgerAccount     @relation(fields: [organisationId, propertyId, incomeAccountId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  recurringCharges RecurringCharge[]
  invoiceLines     InvoiceLine[]
  facilityFees     Facility[]        @relation("FacilityFeeChargeType")
  facilityDeposits Facility[]        @relation("FacilityDepositChargeType")

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, code])
  @@map("charge_types")
}

/// A monthly charge for one unit, or for every active unit of the property (unit null). A
/// unit's own charge replaces the property-wide one of the same type for that unit.
model RecurringCharge {
  id              String               @id @default(uuid(7)) @db.Uuid
  organisationId  String               @map("organisation_id") @db.Uuid
  propertyId      String               @map("property_id") @db.Uuid
  unitId          String?              @map("unit_id") @db.Uuid
  chargeTypeId    String               @map("charge_type_id") @db.Uuid
  basis           RecurringChargeBasis
  /// FLAT: the monthly amount; PER_SQM: the rate per square metre. Minor units, positive.
  amountMinor     BigInt               @map("amount_minor")
  /// First month billed (always the first day of a month).
  startMonth      DateTime             @map("start_month") @db.Date
  /// Last month billed (first day of that month); null while open-ended.
  endMonth        DateTime?            @map("end_month") @db.Date
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  property     Property      @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         Unit?         @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  chargeType   ChargeType    @relation(fields: [organisationId, propertyId, chargeTypeId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?         @relation("RecurringChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoiceLines InvoiceLine[]

  @@unique([organisationId, propertyId, id])
  @@index([organisationId, propertyId, startMonth])
  @@map("recurring_charges")
}

/// A bill for one unit, addressed to its owners or its tenants. Drafts are not in the ledger;
/// issuing numbers the invoice and posts its journal entry.
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  unitId          String        @map("unit_id") @db.Uuid
  /// Sequential per property, assigned when issued.
  invoiceNumber   BigInt?       @map("invoice_number")
  status          InvoiceStatus @default(DRAFT)
  billTo          InvoiceBillTo @map("bill_to")
  /// The tenancy billed when bill_to is TENANTS.
  tenancyId       String?       @map("tenancy_id") @db.Uuid
  /// The month a billing run produced it for (first day); null for one-off invoices.
  billingMonth    DateTime?     @map("billing_month") @db.Date
  /// The property-local date on which the liable party was determined.
  billingDate     DateTime      @map("billing_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  /// Property-local date of issue; also the ledger entry date.
  issueDate       DateTime?     @map("issue_date") @db.Date
  /// ISO 4217; the property's currency.
  currency        String        @db.Char(3)
  /// Sum of the lines, minor units.
  totalMinor      BigInt        @default(0) @map("total_minor")
  journalEntryId  String?       @map("journal_entry_id") @db.Uuid
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedByUserId  String?       @map("issued_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  property     Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         Unit                @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  tenancy      Tenancy?            @relation(fields: [organisationId, tenancyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry?       @relation(fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?               @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy     User?               @relation("InvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines        InvoiceLine[]       @relation("InvoiceLines")
  billedLines  InvoiceLine[]       @relation("InvoiceLineBilledMonth")
  recipients   InvoiceRecipient[]
  allocations  PaymentAllocation[]

  credits   InvoiceCredit[]
  approvals FinanceApproval[]

  facilityBooking FacilityBooking?

  @@unique([organisationId, propertyId, id])
  @@unique([organisationId, propertyId, id, unitId, billingMonth])
  @@unique([organisationId, propertyId, journalEntryId])
  @@unique([organisationId, propertyId, id, unitId])
  @@unique([propertyId, invoiceNumber])
  @@index([organisationId, propertyId, createdAt])
  @@index([organisationId, unitId])
  @@map("invoices")
}

/// One charge on an invoice. Lines from a billing run name their recurring charge, unit and
/// month, which are unique together: a recurring charge is never billed twice for a month.
model InvoiceLine {
  id                String    @id @default(uuid(7)) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  invoiceId         String    @map("invoice_id") @db.Uuid
  lineNumber        Int       @map("line_number")
  chargeTypeId      String    @map("charge_type_id") @db.Uuid
  description       String
  /// Minor units, positive.
  amountMinor       BigInt    @map("amount_minor")
  recurringChargeId String?   @map("recurring_charge_id") @db.Uuid
  unitId            String?   @map("unit_id") @db.Uuid
  billingMonth      DateTime? @map("billing_month") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice         Invoice          @relation("InvoiceLines", fields: [organisationId, propertyId, invoiceId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  billedInvoice   Invoice?         @relation("InvoiceLineBilledMonth", fields: [organisationId, propertyId, invoiceId, unitId, billingMonth], references: [organisationId, propertyId, id, unitId, billingMonth], onDelete: Restrict, onUpdate: Restrict)
  chargeType      ChargeType       @relation(fields: [organisationId, propertyId, chargeTypeId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  recurringCharge RecurringCharge? @relation(fields: [organisationId, propertyId, recurringChargeId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([invoiceId, lineNumber])
  @@unique([recurringChargeId, unitId, billingMonth])
  @@index([organisationId, chargeTypeId])
  @@map("invoice_lines")
}

/// Who an invoice is addressed to, captured when it is created: the owners (with their shares)
/// or the tenants of the tenancy.
model InvoiceRecipient {
  id               String   @id @default(uuid(7)) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  personId         String   @map("person_id") @db.Uuid
  /// Ownership share for owners; null for tenants.
  shareNumerator   Int?     @map("share_numerator")
  shareDenominator Int?     @map("share_denominator")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [organisationId, propertyId, invoiceId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  person  Person  @relation(fields: [organisationId, personId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([invoiceId, personId])
  @@index([organisationId, personId])
  @@map("invoice_recipients")
}

// ---------------------------------------------------------------------------------------------
// Payments (Phase 6 Part 3). A payment is money received for a unit from a party (its owners or
// a tenancy). It posts to unit credit; allocations move credit to the party's invoices. Gateway
// payments start as payment intents completed by signed, idempotent provider callbacks. Rules
// are hand-written in migration 20261112150000_payments.
// ---------------------------------------------------------------------------------------------

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  /// Through a payment gateway (always from a payment intent).
  GATEWAY
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

/// Money received. Never changes; corrections arrive with reversals (Phase 6 Part 4).
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  organisationId   String        @map("organisation_id") @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  /// Who paid: the owners, or the tenancy (tenancy_id).
  paidBy           InvoiceBillTo @map("paid_by")
  tenancyId        String?       @map("tenancy_id") @db.Uuid
  method           PaymentMethod
  /// Minor units, positive.
  amountMinor      BigInt        @map("amount_minor")
  currency         String        @db.Char(3)
  /// Property-local date the money was received; also the ledger date.
  receivedOn       DateTime      @map("received_on") @db.Date
  /// Bank or cheque reference, or the provider's reference.
  reference        String?
  /// Sequential per property, assigned on insert (receipt number).
  receiptNumber    BigInt?       @map("receipt_number")
  journalEntryId   String        @map("journal_entry_id") @db.Uuid
  /// The client's Idempotency-Key: the same key never records a second payment.
  idempotencyKey   String?       @map("idempotency_key") @db.Uuid
  paymentIntentId  String?       @map("payment_intent_id") @db.Uuid
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  property     Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         Unit                @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  tenancy      Tenancy?            @relation(fields: [organisationId, tenancyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry        @relation(fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  intent       PaymentIntent?      @relation(fields: [organisationId, propertyId, paymentIntentId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy   User?               @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocations  PaymentAllocation[]

  refunds   PaymentRefund[]
  reversal  PaymentReversal?
  approvals FinanceApproval[]

  bankTransfer BankTransferSubmission?

  @@unique([organisationId, propertyId, id])
  @@unique([organisationId, propertyId, id, unitId])
  @@unique([organisationId, propertyId, journalEntryId])
  @@unique([organisationId, propertyId, paymentIntentId])
  @@unique([organisationId, idempotencyKey])
  @@unique([propertyId, receiptNumber])
  @@index([organisationId, unitId])
  @@map("payments")
}

/// Part of a payment applied to an invoice of the same unit and party. Released (once) to
/// reallocate; never edited or deleted.
model PaymentAllocation {
  id                String    @id @default(uuid(7)) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  unitId            String    @map("unit_id") @db.Uuid
  paymentId         String    @map("payment_id") @db.Uuid
  invoiceId         String    @map("invoice_id") @db.Uuid
  /// Minor units, positive.
  amountMinor       BigInt    @map("amount_minor")
  /// The ALLOCATION entry moving unit credit to receivables.
  journalEntryId    String    @map("journal_entry_id") @db.Uuid
  allocatedByUserId String?   @map("allocated_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt        DateTime? @map("released_at") @db.Timestamptz(3)
  releasedByUserId  String?   @map("released_by_user_id") @db.Uuid
  /// The ALLOCATION entry moving the amount back to unit credit.
  releaseEntryId    String?   @map("release_entry_id") @db.Uuid

  payment      Payment       @relation(fields: [organisationId, propertyId, paymentId, unitId], references: [organisationId, propertyId, id, unitId], onDelete: Restrict, onUpdate: Restrict)
  invoice      Invoice       @relation(fields: [organisationId, propertyId, invoiceId, unitId], references: [organisationId, propertyId, id, unitId], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry  @relation("AllocationEntry", fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  releaseEntry JournalEntry? @relation("AllocationReleaseEntry", fields: [organisationId, propertyId, releaseEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  allocatedBy  User?         @relation("AllocationMadeBy", fields: [allocatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releasedBy   User?         @relation("AllocationReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, paymentId])
  @@index([organisationId, invoiceId])
  @@map("payment_allocations")
}

/// An online payment in progress. A provider callback completes it once.
model PaymentIntent {
  id                String              @id @default(uuid(7)) @db.Uuid
  organisationId    String              @map("organisation_id") @db.Uuid
  propertyId        String              @map("property_id") @db.Uuid
  unitId            String              @map("unit_id") @db.Uuid
  paidBy            InvoiceBillTo       @map("paid_by")
  tenancyId         String?             @map("tenancy_id") @db.Uuid
  amountMinor       BigInt              @map("amount_minor")
  currency          String              @db.Char(3)
  /// Adapter key, e.g. "sandbox".
  provider          String
  /// The provider's id for this payment; how callbacks find it.
  providerReference String              @map("provider_reference")
  status            PaymentIntentStatus @default(PENDING)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdByUserId   String?             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  property  Property               @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit                   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  tenancy   Tenancy?               @relation(fields: [organisationId, tenancyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?                  @relation("PaymentIntentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment   Payment?
  events    PaymentProviderEvent[]

  @@unique([organisationId, propertyId, id])
  @@unique([provider, providerReference])
  @@index([organisationId, propertyId, createdAt])
  @@map("payment_intents")
}

/// Every provider callback processed, once per (provider, event id). Append-only.
model PaymentProviderEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  type            String
  intentId        String   @map("intent_id") @db.Uuid
  /// What VEYRA did: RECORDED, FAILED, IGNORED_NOT_PENDING, AMOUNT_MISMATCH.
  outcome         String
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  property Property      @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  intent   PaymentIntent @relation(fields: [organisationId, propertyId, intentId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerEventId])
  @@index([organisationId, intentId])
  @@map("payment_provider_events")
}

// ---------------------------------------------------------------------------------------------
// Controls (Phase 6 Part 4). Risky actions (payment reversals, refunds, write-offs, reopening a
// closed period) need a second person's approval (maker-checker); credit notes correct issued
// invoices. Rules are hand-written in migration 20261112180000_controls.
// ---------------------------------------------------------------------------------------------

enum FinanceApprovalAction {
  REVERSE_PAYMENT
  REFUND
  WRITE_OFF
  REOPEN_PERIOD
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceCreditKind {
  /// Corrects an issued invoice (income reduced). No approval needed.
  CREDIT_NOTE
  /// Gives up on what is owed (bad debt). Needs an approval.
  WRITE_OFF
}

/// A request for a risky finance action. Approved or rejected by someone other than the
/// requester; an approval is carried out in the same transaction.
model FinanceApproval {
  id                String                @id @default(uuid(7)) @db.Uuid
  organisationId    String                @map("organisation_id") @db.Uuid
  propertyId        String                @map("property_id") @db.Uuid
  action            FinanceApprovalAction
  status            FinanceApprovalStatus @default(PENDING)
  paymentId         String?               @map("payment_id") @db.Uuid
  invoiceId         String?               @map("invoice_id") @db.Uuid
  periodId          String?               @map("period_id") @db.Uuid
  /// REFUND and WRITE_OFF: the amount, minor units.
  amountMinor       BigInt?               @map("amount_minor")
  /// REFUND: how the money is paid back.
  refundMethod      PaymentMethod?        @map("refund_method")
  reason            String
  requestedByUserId String                @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?               @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?               @map("decision_note")
  /// When an approved action was carried out (same transaction as the approval).
  executedAt        DateTime?             @map("executed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property          @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  payment     Payment?          @relation(fields: [organisationId, propertyId, paymentId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice     Invoice?          @relation(fields: [organisationId, propertyId, invoiceId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  period      AccountingPeriod? @relation(fields: [organisationId, propertyId, periodId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User              @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy   User?             @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credit      InvoiceCredit?
  refund      PaymentRefund?
  reversal    PaymentReversal?

  @@unique([organisationId, propertyId, id])
  @@index([organisationId, propertyId, status])
  @@map("finance_approvals")
}

/// A credit note or write-off reducing what an issued invoice still owes. Never changes.
model InvoiceCredit {
  id              String            @id @default(uuid(7)) @db.Uuid
  organisationId  String            @map("organisation_id") @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  unitId          String            @map("unit_id") @db.Uuid
  invoiceId       String            @map("invoice_id") @db.Uuid
  kind            InvoiceCreditKind
  /// Credit notes: sequential per property, assigned on insert. Null for write-offs.
  creditNumber    BigInt?           @map("credit_number")
  /// Credit notes: the invoice line corrected.
  lineNumber      Int?              @map("line_number")
  amountMinor     BigInt            @map("amount_minor")
  reason          String
  /// Property-local date; also the ledger date.
  creditedOn      DateTime          @map("credited_on") @db.Date
  journalEntryId  String            @map("journal_entry_id") @db.Uuid
  /// Write-offs: the approval that allowed it.
  approvalId      String?           @map("approval_id") @db.Uuid
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice      Invoice          @relation(fields: [organisationId, propertyId, invoiceId, unitId], references: [organisationId, propertyId, id, unitId], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry     @relation(fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  approval     FinanceApproval? @relation(fields: [organisationId, propertyId, approvalId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?            @relation("InvoiceCreditCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId, propertyId, journalEntryId])
  @@unique([organisationId, propertyId, approvalId])
  @@unique([propertyId, creditNumber])
  @@index([organisationId, invoiceId])
  @@map("invoice_credits")
}

/// Unused payment money paid back to the payer. Needs an approval. Never changes.
model PaymentRefund {
  id              String        @id @default(uuid(7)) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  unitId          String        @map("unit_id") @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  amountMinor     BigInt        @map("amount_minor")
  method          PaymentMethod
  refundedOn      DateTime      @map("refunded_on") @db.Date
  journalEntryId  String        @map("journal_entry_id") @db.Uuid
  approvalId      String        @map("approval_id") @db.Uuid
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  payment      Payment         @relation(fields: [organisationId, propertyId, paymentId, unitId], references: [organisationId, propertyId, id, unitId], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry    @relation(fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  approval     FinanceApproval @relation(fields: [organisationId, propertyId, approvalId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?           @relation("PaymentRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId, propertyId, journalEntryId])
  @@unique([organisationId, propertyId, approvalId])
  @@index([organisationId, paymentId])
  @@map("payment_refunds")
}

/// A payment taken back entirely (e.g. a bounced cheque): its ledger entry is reversed. Needs an
/// approval. A payment is reversed at most once.
model PaymentReversal {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @map("organisation_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  reversedOn      DateTime @map("reversed_on") @db.Date
  journalEntryId  String   @map("journal_entry_id") @db.Uuid
  approvalId      String   @map("approval_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment      Payment         @relation(fields: [organisationId, propertyId, paymentId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  journalEntry JournalEntry    @relation(fields: [organisationId, propertyId, journalEntryId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  approval     FinanceApproval @relation(fields: [organisationId, propertyId, approvalId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?           @relation("PaymentReversalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId, propertyId, paymentId])
  @@unique([organisationId, propertyId, journalEntryId])
  @@unique([organisationId, propertyId, approvalId])
  @@map("payment_reversals")
}

// ---------------------------------------------------------------------------------------------
// Residents' finance (Phase 6 Part 6). An owner or current tenant tells finance about a bank
// transfer they made; finance confirms it (recording a BANK_TRANSFER payment) or rejects it.
// Rules are hand-written in migration 20261113090000_bank_transfers.
// ---------------------------------------------------------------------------------------------

enum BankTransferStatus {
  /// Waiting for finance to find the money in the bank account.
  PENDING
  /// Found: a BANK_TRANSFER payment was recorded for it.
  CONFIRMED
  /// Not found or not matching; the reason is shown to the resident.
  REJECTED
}

/// A resident's report of a bank transfer for their own party of a unit. Never deleted; decided
/// once by someone other than the submitter.
model BankTransferSubmission {
  id                String             @id @default(uuid(7)) @db.Uuid
  organisationId    String             @map("organisation_id") @db.Uuid
  propertyId        String             @map("property_id") @db.Uuid
  unitId            String             @map("unit_id") @db.Uuid
  /// Whose account it pays: the owners, or the tenancy (tenancy_id).
  paidBy            InvoiceBillTo      @map("paid_by")
  tenancyId         String?            @map("tenancy_id") @db.Uuid
  /// Minor units, positive.
  amountMinor       BigInt             @map("amount_minor")
  /// The property's currency.
  currency          String             @db.Char(3)
  /// Property-local date the resident says the money was sent.
  transferredOn     DateTime           @map("transferred_on") @db.Date
  /// The bank's reference for the transfer, as the resident sees it.
  reference         String
  note              String?
  status            BankTransferStatus @default(PENDING)
  submittedByUserId String             @map("submitted_by_user_id") @db.Uuid
  /// The client's Idempotency-Key: the same key never submits twice.
  idempotencyKey    String             @map("idempotency_key") @db.Uuid
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  rejectionReason   String?            @map("rejection_reason")
  /// CONFIRMED: the payment recorded for it.
  paymentId         String?            @map("payment_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit     @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  tenancy     Tenancy? @relation(fields: [organisationId, tenancyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  payment     Payment? @relation(fields: [organisationId, propertyId, paymentId, unitId], references: [organisationId, propertyId, id, unitId], onDelete: Restrict, onUpdate: Restrict)
  submittedBy User     @relation("BankTransferSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy   User?    @relation("BankTransferDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId, propertyId, id])
  @@unique([organisationId, propertyId, paymentId, unitId])
  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, propertyId, status, createdAt])
  @@index([organisationId, unitId])
  @@map("bank_transfer_submissions")
}

// ---------------------------------------------------------------------------------------------
// Maintenance and work orders (Phase 7). A resident or staff member reports a problem (request);
// staff accept it and do the work through work orders, record costs (for reporting only) and
// the resident confirms or reopens. Every status change is logged by the database. Rules are
// hand-written in migration 20261114090000_maintenance.
// ---------------------------------------------------------------------------------------------

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  CARPENTRY
  PAINTING
  PEST_CONTROL
  CLEANING
  LIFT
  SECURITY_SYSTEM
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  /// Reported; waiting for staff to look at it.
  SUBMITTED
  /// Staff took it on; work orders do the work.
  ACCEPTED
  /// Work done; waiting for the requester to confirm (or reopen).
  RESOLVED
  /// Confirmed, or closed by staff. Final.
  CLOSED
  /// Declined by staff with a reason. Final.
  REJECTED
  /// Withdrawn before the work was done. Final.
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  /// Final.
  COMPLETED
  /// Final.
  CANCELLED
}

enum WorkOrderCostKind {
  LABOUR
  MATERIAL
  OTHER
}

enum MaintenanceEventType {
  /// A status change of a request or work order (written by the database only).
  STATUS_CHANGED
  /// A work order's assignee changed (written by the database only).
  ASSIGNEE_CHANGED
  /// A request's or work order's priority changed (written by the database only).
  PRIORITY_CHANGED
  /// A note or an update for the requester.
  NOTE
  /// A response or resolution target was missed (written by the database only, Part 4).
  SLA_BREACHED
}

enum MaintenanceEventVisibility {
  /// Shown to the requester and the unit's residents.
  RESIDENT
  /// Staff only.
  INTERNAL
}

/// How quickly a property promises to respond to (accept) and resolve requests of a priority.
model MaintenanceSlaTarget {
  id                String              @id @default(uuid(7)) @db.Uuid
  organisationId    String              @map("organisation_id") @db.Uuid
  propertyId        String              @map("property_id") @db.Uuid
  priority          MaintenancePriority
  responseMinutes   Int                 @map("response_minutes")
  resolutionMinutes Int                 @map("resolution_minutes")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([propertyId, priority])
  @@index([organisationId, propertyId])
  @@map("maintenance_sla_targets")
}

/// A reported problem in a unit or a common area. The report itself never changes; its status
/// moves only along the allowed transitions, each logged in maintenance_events.
model MaintenanceRequest {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  organisationId       String                   @map("organisation_id") @db.Uuid
  propertyId           String                   @map("property_id") @db.Uuid
  /// Exactly one of unit and common area.
  unitId               String?                  @map("unit_id") @db.Uuid
  commonAreaId         String?                  @map("common_area_id") @db.Uuid
  /// Sequential per property, assigned on insert (MR-000042).
  requestNumber        BigInt?                  @map("request_number")
  category             MaintenanceCategory
  priority             MaintenancePriority
  title                String
  description          String
  /// Where exactly, e.g. "Kitchen sink".
  locationDetail       String?                  @map("location_detail")
  status               MaintenanceRequestStatus @default(SUBMITTED)
  /// The reason given with the latest status change that needs one (reject, cancel, reopen).
  statusNote           String?                  @map("status_note")
  submittedByUserId    String                   @map("submitted_by_user_id") @db.Uuid
  acceptedByUserId     String?                  @map("accepted_by_user_id") @db.Uuid
  acceptedAt           DateTime?                @map("accepted_at") @db.Timestamptz(3)
  /// From the property's SLA target for the priority (null without a target).
  responseDueAt        DateTime?                @map("response_due_at") @db.Timestamptz(3)
  resolutionDueAt      DateTime?                @map("resolution_due_at") @db.Timestamptz(3)
  /// When the response target was found missed (set once, only after it passed unmet).
  responseBreachedAt   DateTime?                @map("response_breached_at") @db.Timestamptz(3)
  /// When the resolution target was found missed (set once, only after it passed unmet).
  resolutionBreachedAt DateTime?                @map("resolution_breached_at") @db.Timestamptz(3)
  resolvedAt           DateTime?                @map("resolved_at") @db.Timestamptz(3)
  closedAt             DateTime?                @map("closed_at") @db.Timestamptz(3)
  reopenCount          Int                      @default(0) @map("reopen_count")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property                @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit?                   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  commonArea  CommonArea?             @relation(fields: [organisationId, propertyId, commonAreaId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy User                    @relation("MaintenanceRequestSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy  User?                   @relation("MaintenanceRequestAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workOrders  WorkOrder[]
  events      MaintenanceEvent[]
  attachments MaintenanceAttachment[]

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, requestNumber])
  @@index([organisationId, propertyId, status, createdAt])
  @@index([organisationId, unitId])
  @@map("maintenance_requests")
}

/// A piece of work, from an accepted request or raised by staff directly.
model WorkOrder {
  id               String              @id @default(uuid(7)) @db.Uuid
  organisationId   String              @map("organisation_id") @db.Uuid
  propertyId       String              @map("property_id") @db.Uuid
  requestId        String?             @map("request_id") @db.Uuid
  /// Exactly one of unit and common area; the request's when there is one.
  unitId           String?             @map("unit_id") @db.Uuid
  commonAreaId     String?             @map("common_area_id") @db.Uuid
  /// Sequential per property, assigned on insert (WO-000042).
  workOrderNumber  BigInt?             @map("work_order_number")
  category         MaintenanceCategory
  priority         MaintenancePriority
  title            String
  description      String?
  status           WorkOrderStatus     @default(OPEN)
  /// The reason or note given with the latest status change that needs one (cancel, complete).
  statusNote       String?             @map("status_note")
  assignedToUserId String?             @map("assigned_to_user_id") @db.Uuid
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  dueAt            DateTime?           @map("due_at") @db.Timestamptz(3)
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property                @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  request     MaintenanceRequest?     @relation(fields: [organisationId, propertyId, requestId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit?                   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  commonArea  CommonArea?             @relation(fields: [organisationId, propertyId, commonAreaId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  assignedTo  User?                   @relation("WorkOrderAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User                    @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  costs       WorkOrderCost[]
  events      MaintenanceEvent[]
  attachments MaintenanceAttachment[]

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, workOrderNumber])
  @@index([organisationId, propertyId, status, createdAt])
  @@index([organisationId, assignedToUserId, status])
  @@index([organisationId, requestId])
  @@map("work_orders")
}

/// Labour, materials or other cost of a work order, for reporting (never billed in Phase 7).
/// Corrected by voiding, never edited.
model WorkOrderCost {
  id               String            @id @default(uuid(7)) @db.Uuid
  organisationId   String            @map("organisation_id") @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  workOrderId      String            @map("work_order_id") @db.Uuid
  kind             WorkOrderCostKind
  description      String
  /// Minor units, positive.
  amountMinor      BigInt            @map("amount_minor")
  /// The property's currency.
  currency         String            @db.Char(3)
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidedByUserId   String?           @map("voided_by_user_id") @db.Uuid
  voidReason       String?           @map("void_reason")

  property   Property  @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrder  WorkOrder @relation(fields: [organisationId, propertyId, workOrderId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy User      @relation("WorkOrderCostRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voidedBy   User?     @relation("WorkOrderCostVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, workOrderId])
  @@map("work_order_costs")
}

/// History of a request and its work orders. Append-only for every role. Status, assignee and
/// priority changes are written by the database itself; notes by the application.
model MaintenanceEvent {
  id             String                     @id @default(uuid(7)) @db.Uuid
  /// The order of history (several events can share a timestamp).
  sequence       BigInt                     @default(autoincrement())
  organisationId String                     @map("organisation_id") @db.Uuid
  propertyId     String                     @map("property_id") @db.Uuid
  /// Set on every event of a request or of a work order that belongs to one.
  requestId      String?                    @map("request_id") @db.Uuid
  workOrderId    String?                    @map("work_order_id") @db.Uuid
  type           MaintenanceEventType
  visibility     MaintenanceEventVisibility
  fromValue      String?                    @map("from_value")
  toValue        String?                    @map("to_value")
  body           String?
  actorUserId    String?                    @map("actor_user_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  property  Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  request   MaintenanceRequest? @relation(fields: [organisationId, propertyId, requestId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrder WorkOrder?          @relation(fields: [organisationId, propertyId, workOrderId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  actor     User?               @relation("MaintenanceEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sequence])
  @@index([organisationId, requestId, sequence])
  @@index([organisationId, workOrderId, sequence])
  @@map("maintenance_events")
}

enum AttachmentStatus {
  /// A signed upload URL was handed out; the bytes may not have arrived yet.
  PENDING
  /// Checked: the stored object has the declared size and really is the declared type.
  READY
  /// Failed the check; the object was deleted.
  REJECTED
}

enum AttachmentKind {
  BEFORE
  AFTER
  OTHER
}

/// A photo or PDF on a request or a work order (Phase 7 Part 3). The bytes live in object
/// storage under storage_key; this row is the metadata and the access decision. Rules are
/// hand-written in migration 20261115090000_maintenance_attachments.
model MaintenanceAttachment {
  id               String                     @id @default(uuid(7)) @db.Uuid
  organisationId   String                     @map("organisation_id") @db.Uuid
  propertyId       String                     @map("property_id") @db.Uuid
  /// Set for every attachment of a request, or of a work order that belongs to one.
  requestId        String?                    @map("request_id") @db.Uuid
  workOrderId      String?                    @map("work_order_id") @db.Uuid
  /// Chosen by the server, never derived from the file name.
  storageKey       String                     @map("storage_key")
  fileName         String                     @map("file_name")
  contentType      String                     @map("content_type")
  sizeBytes        Int                        @map("size_bytes")
  kind             AttachmentKind             @default(OTHER)
  visibility       MaintenanceEventVisibility
  status           AttachmentStatus           @default(PENDING)
  uploadedByUserId String                     @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt          DateTime?                  @map("ready_at") @db.Timestamptz(3)
  /// Removed attachments stay listed in history; their object is deleted.
  removedAt        DateTime?                  @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?                    @map("removed_by_user_id") @db.Uuid

  property   Property            @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  request    MaintenanceRequest? @relation(fields: [organisationId, propertyId, requestId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrder  WorkOrder?          @relation(fields: [organisationId, propertyId, workOrderId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User                @relation("MaintenanceAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedBy  User?               @relation("MaintenanceAttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([storageKey])
  @@index([organisationId, requestId])
  @@index([organisationId, workOrderId])
  @@map("maintenance_attachments")
}

// ---------------------------------------------------------------------------------------------
// Facilities and reservations (Phase 8). A facility is the booking setup of a common area: slot
// length, capacity, opening hours, notice and advance windows, a per-unit limit and whether
// bookings need approval. Bookings are made for a unit in whole slots inside opening hours and
// outside closures; capacity and limits are checked by the database under a per-facility lock.
// Every status change is logged by the database. Rules are hand-written in migration
// 20261117090000_facilities.
// ---------------------------------------------------------------------------------------------

enum FacilityStatus {
  ACTIVE
  /// Kept for history; takes no new bookings.
  ARCHIVED
}

enum FacilityBookingStatus {
  /// Waiting for staff approval. Holds its place.
  PENDING
  CONFIRMED
  /// Declined by staff with a reason. Final.
  REJECTED
  /// Withdrawn (with a reason once confirmed). Final.
  CANCELLED
  /// Used. Final.
  COMPLETED
  /// Not used. Final.
  NO_SHOW
}

/// The booking setup of one common area.
model Facility {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organisationId      String         @map("organisation_id") @db.Uuid
  propertyId          String         @map("property_id") @db.Uuid
  commonAreaId        String         @map("common_area_id") @db.Uuid
  /// Rules shown to residents, e.g. "No glass by the pool".
  description         String?
  status              FacilityStatus @default(ACTIVE)
  /// Length of one slot; bookings are whole slots starting on a slot boundary of an opening range.
  slotMinutes         Int            @map("slot_minutes")
  /// Bookings that may overlap at any moment (1 = exclusive use).
  capacity            Int            @default(1)
  /// Bookings wait for staff approval when true; otherwise they are confirmed at once.
  approvalRequired    Boolean        @default(false) @map("approval_required")
  /// How long before its start a booking must be made.
  minNoticeMinutes    Int            @default(0) @map("min_notice_minutes")
  /// How far ahead a booking may start.
  maxAdvanceDays      Int            @default(30) @map("max_advance_days")
  maxSlotsPerBooking  Int            @default(1) @map("max_slots_per_booking")
  /// Pending or confirmed bookings of this facility that a unit may hold before they end; null = no limit.
  maxUpcomingPerUnit  Int?           @map("max_upcoming_per_unit")
  /// Residents cannot cancel later than this before the start (staff can).
  cancellationMinutes Int            @default(0) @map("cancellation_minutes")
  /// Charged per slot to the unit's account when a booking is confirmed (Part 3); both or neither.
  feeChargeTypeId     String?        @map("fee_charge_type_id") @db.Uuid
  feePerSlotMinor     BigInt?        @map("fee_per_slot_minor")
  /// Charged once per booking with the fee; books to a liability (deposits held); both or neither.
  depositChargeTypeId String?        @map("deposit_charge_type_id") @db.Uuid
  depositMinor        BigInt?        @map("deposit_minor")
  archivedAt          DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  property          Property               @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  commonArea        CommonArea             @relation(fields: [organisationId, propertyId, commonAreaId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  feeChargeType     ChargeType?            @relation("FacilityFeeChargeType", fields: [organisationId, propertyId, feeChargeTypeId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  depositChargeType ChargeType?            @relation("FacilityDepositChargeType", fields: [organisationId, propertyId, depositChargeTypeId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  openingHours      FacilityOpeningHours[]
  closures          FacilityClosure[]
  bookings          FacilityBooking[]

  @@unique([organisationId, propertyId, commonAreaId])
  @@unique([organisationId, propertyId, id])
  @@index([organisationId, propertyId])
  @@map("facilities")
}

/// When a facility is open on a weekday, in the property's local time. A day may have several
/// ranges that never overlap. Replaced (deleted and added) when staff change them.
model FacilityOpeningHours {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  facilityId     String   @map("facility_id") @db.Uuid
  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday        Int
  opensAt        DateTime @map("opens_at") @db.Time(0)
  /// Later than opens_at; 24:00 closes at midnight.
  closesAt       DateTime @map("closes_at") @db.Time(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  facility Facility @relation(fields: [organisationId, propertyId, facilityId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, facilityId, weekday])
  @@map("facility_opening_hours")
}

/// A period when a facility cannot be booked (maintenance, private event). Never overlaps a
/// pending or confirmed booking: those are cancelled first. Lifted, never deleted.
model FacilityClosure {
  id              String    @id @default(uuid(7)) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(3)
  reason          String
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt        DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedByUserId  String?   @map("lifted_by_user_id") @db.Uuid

  property  Property @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  facility  Facility @relation(fields: [organisationId, propertyId, facilityId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation("FacilityClosureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  liftedBy  User?    @relation("FacilityClosureLiftedBy", fields: [liftedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, facilityId, startsAt])
  @@map("facility_closures")
}

/// A reservation of a facility for a unit. Where and when never change; the status moves only
/// along the allowed transitions, each logged in facility_booking_events.
model FacilityBooking {
  id                String                @id @default(uuid(7)) @db.Uuid
  organisationId    String                @map("organisation_id") @db.Uuid
  propertyId        String                @map("property_id") @db.Uuid
  facilityId        String                @map("facility_id") @db.Uuid
  unitId            String                @map("unit_id") @db.Uuid
  /// Sequential per property, assigned on insert (BK-000042).
  bookingNumber     BigInt?               @map("booking_number")
  startsAt          DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime              @map("ends_at") @db.Timestamptz(3)
  /// Whole slots booked; set by the database.
  slotCount         Int                   @default(0) @map("slot_count")
  /// Set by the database on insert: PENDING when the facility needs approval, else CONFIRMED.
  status            FacilityBookingStatus @default(PENDING)
  /// The reason given with the latest status change that needs one (reject, cancel once confirmed).
  statusNote        String?               @map("status_note")
  /// What the booking is for, e.g. "Birthday party".
  purpose           String?
  bookedByUserId    String                @map("booked_by_user_id") @db.Uuid
  /// Who approved or rejected a pending booking, and when.
  decidedByUserId   String?               @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(3)
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  /// The fee (slots x the facility's fee per slot) and deposit when booked, minor units; set by the database.
  feeMinor          BigInt                @default(0) @map("fee_minor")
  depositMinor      BigInt                @default(0) @map("deposit_minor")
  /// The invoice issued when the booking was confirmed (set once).
  invoiceId         String?               @map("invoice_id") @db.Uuid
  /// When the deposit was credited back (set once).
  depositReleasedAt DateTime?             @map("deposit_released_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  property  Property               @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice   Invoice?               @relation(fields: [organisationId, propertyId, invoiceId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  facility  Facility               @relation(fields: [organisationId, propertyId, facilityId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit                   @relation(fields: [organisationId, propertyId, unitId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  bookedBy  User                   @relation("FacilityBookingBookedBy", fields: [bookedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy User?                  @relation("FacilityBookingDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events    FacilityBookingEvent[]

  @@unique([organisationId, propertyId, id])
  @@unique([propertyId, bookingNumber])
  @@unique([organisationId, propertyId, invoiceId])
  @@index([organisationId, facilityId, startsAt])
  @@index([organisationId, unitId, startsAt])
  @@map("facility_bookings")
}

/// Append-only history of a booking's status, written by the database.
model FacilityBookingEvent {
  id             String                 @id @default(uuid(7)) @db.Uuid
  sequence       BigInt                 @unique @default(autoincrement())
  organisationId String                 @map("organisation_id") @db.Uuid
  propertyId     String                 @map("property_id") @db.Uuid
  bookingId      String                 @map("booking_id") @db.Uuid
  fromStatus     FacilityBookingStatus? @map("from_status")
  toStatus       FacilityBookingStatus  @map("to_status")
  note           String?
  actorUserId    String?                @map("actor_user_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property        @relation(fields: [organisationId, propertyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  booking  FacilityBooking @relation(fields: [organisationId, propertyId, bookingId], references: [organisationId, propertyId, id], onDelete: Restrict, onUpdate: Restrict)
  actor    User?           @relation("FacilityBookingEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, bookingId, sequence])
  @@map("facility_booking_events")
}

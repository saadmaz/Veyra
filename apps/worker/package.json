{
  "name": "@veyra/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@veyra/db": "workspace:*",
    "@veyra/domain": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  }
}
